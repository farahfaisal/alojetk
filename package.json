{
  "name": "alo-jitak",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "cap:open:ios": "cap open ios",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios",
    "android:build": "npm run build && cap sync android && cd android && ./gradlew assembleRelease && cd ..",
    "android:build:debug": "npm run build && cap sync android && cd android && ./gradlew assembleDebug && cd ..",
    "ios:build": "npm run build && cap sync ios && cd ios && xcodebuild -workspace App/App.xcworkspace -scheme App -configuration Release && cd .."
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/geolocation": "^6.0.1",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/keyboard": "^6.0.2",
    "@capacitor/push-notifications": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@react-google-maps/api": "^2.20.7",
    "@supabase/supabase-js": "^2.39.7",
    "@types/uuid": "^10.0.0",
    "axios": "^1.6.7",
    "firebase": "^12.0.0",
    "framer-motion": "^11.0.3",
    "lucide-react": "^0.323.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "react-slick": "^0.30.3",
    "slick-carousel": "^1.8.1",
    "swiper": "^11.0.6",
    "use-places-autocomplete": "^4.0.1",
    "uuid": "^11.1.0",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.12",
    "vite-plugin-pwa": "^0.20.5",
    "workbox-window": "^7.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "vite": "^5.0.12"
  }
}
